{
  "name": "termosc",
  "version": "1.0.0",
  "description": "OSC 133/633 shell integration parser, output extractor, and injection scripts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "vitest run tests/e2e/ --testTimeout 30000",
    "test:all": "vitest run --testTimeout 30000",
    "test:watch": "vitest --exclude 'tests/e2e/**'"
  },
  "author": "YoseiUshida",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@lydell/node-pty": "1.1.0",
    "@xterm/headless": "^5.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
